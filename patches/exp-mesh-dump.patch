+/* local experiment, not for upstream: with EXP_MESH_DUMP=<unix dir>, binds a 64 MiB dump buffer at mesh index 10 for a
+   tessellated draw, after writing what the previous one recorded to <dir>/dump-<n>.bin and clearing its count */
+static void
+exp_mesh_dump(id<MTLRenderCommandEncoder> encoder) {
+  static id<MTLBuffer> buffer;
+  static int draws;
+  const char *dir = getenv("EXP_MESH_DUMP");
+  if (!dir)
+    return;
+  if (!buffer) {
+    buffer = [[encoder device] newBufferWithLength:64 << 20 options:MTLResourceStorageModeShared];
+  } else {
+    uint32_t *words = buffer.contents;
+    uint32_t size = words[1], capacity = size ? ((16u << 20) - 4) / size : 0;
+    uint32_t records = words[0] < capacity ? words[0] : capacity;
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/dump-%03d.bin", dir, draws++);
+    FILE *file = fopen(path, "wb");
+    if (file) {
+      fwrite(words, 4, 4 + (size_t)records * size, file);
+      fclose(file);
+    }
+  }
+  memset(buffer.contents, 0, 16);
+  [encoder setMeshBuffer:buffer offset:0 atIndex:10];
+}
