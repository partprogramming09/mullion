+/* local experiment, not for upstream: with EXP_METAL_LOG set, writes a line to stderr for each encoder and command */
+static bool
+exp_logging(void) {
+  static int on = -1;
+  if (on < 0)
+    on = getenv("EXP_METAL_LOG") != NULL;
+  return on;
+}
+
+/* writes a formatted line when EXP_METAL_LOG is set */
+static void
+exp_log(const char *format, ...) {
+  if (!exp_logging())
+    return;
+  va_list args;
+  va_start(args, format);
+  vfprintf(stderr, format, args);
+  va_end(args);
+}
+
+/* writes a command's type and its words after the header (up to 128 bytes, or to the next command) */
+static void
+exp_log_cmd(const char *kind, const struct wmtcmd_base *cmd) {
+  if (!exp_logging())
+    return;
+  const uint64_t *words = (const uint64_t *)cmd;
+  const char *here = (const char *)cmd, *next = (const char *)cmd->next.ptr;
+  uint64_t size = next > here && next - here <= 128 ? (uint64_t)(next - here) : 64;
+  fprintf(stderr, "EXP %s %u:", kind, cmd->type);
+  for (uint64_t i = 2; i < size / 8; i++)
+    fprintf(stderr, " %llx", (unsigned long long)words[i]);
+  fprintf(stderr, "\n");
+}
+
